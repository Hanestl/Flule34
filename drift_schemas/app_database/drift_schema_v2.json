    {
      "name": "user_accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_accounts\" (\"user_id\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"avatar_url\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"last_authenticated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"user_id\"));"
        }
      ]
    },
    {
      "name": "playback_positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_positions\" (\"user_id\" TEXT NOT NULL REFERENCES user_accounts (user_id) ON DELETE CASCADE, \"video_id\" TEXT NOT NULL, \"title\" TEXT NULL, \"slug\" TEXT NULL, \"thumbnail_url\" TEXT NULL, \"duration_label\" TEXT NULL, \"position_ms\" INTEGER NOT NULL DEFAULT 0, \"duration_ms\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"user_id\", \"video_id\"));"
        }
      ]
    },
    {
      "name": "download_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"download_records\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL REFERENCES user_accounts (user_id) ON DELETE CASCADE, \"video_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"quality\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"task_id\" TEXT NULL, \"file_path\" TEXT NULL, \"bytes_downloaded\" INTEGER NOT NULL DEFAULT 0, \"total_bytes\" INTEGER NULL, \"error_message\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"completed_at\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"user_id\", \"video_id\", \"quality\"));"
        }
      ]
    }
