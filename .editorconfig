root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.dart]
indent_style = space
indent_size = 2

[*.{yaml,yml,json}]
indent_style = space
indent_size = 2

[*.{kt,kts,java}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
